<Window x:Class="BlackScreens.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BlackScreens.Ui"
        Title="BlackScreens"
        Width="880" Height="640"
        MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource WindowBackgroundBrush}">

  <Window.Resources>
    <ui:ProcessIconConverter x:Key="ProcessIcon" />
    <ui:ProcessLabelConverter x:Key="ProcessLabel" />
    <ui:ProcessDetailConverter x:Key="ProcessDetail" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="192" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Nav rail. A ListBox rather than a TabControl: once a TabControl template is replaced, its
           automation peer stops exposing the selected page, so screen readers see an empty window. -->
      <Border Grid.Column="0" Background="{DynamicResource NavBackgroundBrush}">
        <StackPanel>
          <TextBlock Text="BlackScreens" FontSize="15" FontWeight="SemiBold" Margin="18,18,18,2" />
          <TextBlock Text="Settings" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                     Margin="18,0,18,14" />
          <ListBox x:Name="Nav"
                   Style="{StaticResource NavList}"
                   ItemContainerStyle="{StaticResource NavItem}"
                   SelectedIndex="0"
                   AutomationProperties.Name="Settings sections"
                   SelectionChanged="NavSelectionChanged">
            <ListBoxItem Content="General" Tag="{StaticResource IconGeneral}" />
            <ListBoxItem Content="Detection" Tag="{StaticResource IconDetection}" />
            <ListBoxItem Content="Blackout" Tag="{StaticResource IconBlackout}" />
            <ListBoxItem Content="Monitors" Tag="{StaticResource IconMonitors}" />
            <ListBoxItem Content="Denylist" Tag="{StaticResource IconDenylist}" />
            <ListBoxItem Content="On top" Tag="{StaticResource IconOnTop}" />
            <ListBoxItem Content="About" Tag="{StaticResource IconAbout}" />
          </ListBox>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">

        <!-- General -->
        <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28,26,28,26">
            <TextBlock Text="General" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="How BlackScreens starts, looks, and responds to the keyboard." />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                <TextBlock Style="{StaticResource Hint}"
                           Margin="28,6,0,0"
                           Text="Adds BlackScreens to the current user's startup items. No admin rights needed." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <RadioButton Content="Follow Windows" GroupName="Theme" IsChecked="{Binding ThemeIsSystem}" />
                  <RadioButton Content="Dark" GroupName="Theme" IsChecked="{Binding ThemeIsDark}" />
                  <RadioButton Content="Light" GroupName="Theme" IsChecked="{Binding ThemeIsLight}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Pause hotkey" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="HotkeyBox"
                         Width="220"
                         HorizontalAlignment="Left"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="False"
                         Text="{Binding HotkeyText, Mode=OneWay}"
                         AutomationProperties.Name="Pause hotkey"
                         PreviewKeyDown="HotkeyBoxPreviewKeyDown"
                         ToolTip="Click here, then press the shortcut you want." />
                <TextBlock Style="{StaticResource Hint}"
                           Margin="0,8,0,0"
                           Text="Click the box and press a shortcut. It needs Ctrl, Alt or Win plus one key." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Detection interval" Style="{StaticResource FieldLabel}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0"
                          Minimum="100" Maximum="2000"
                          TickFrequency="50"
                          IsSnapToTickEnabled="True"
                          AutomationProperties.Name="Detection interval in milliseconds"
                          Value="{Binding PollIntervalMs}" />
                  <TextBlock Grid.Column="1"
                             MinWidth="64"
                             Margin="14,0,0,0"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Text="{Binding PollIntervalText, Mode=OneWay}" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}"
                           Margin="0,8,0,0"
                           Text="How often BlackScreens checks the foreground window. Lower reacts faster, higher uses less CPU." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Detection -->
        <ScrollViewer x:Name="PageDetection" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="28,26,28,26">
            <TextBlock Text="Detection" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Blackout starts only for a fullscreen or borderless window that is not on the denylist." />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <CheckBox Content="Also black out when a game is fullscreen in the background"
                          IsChecked="{Binding BackgroundGames}" />
                <TextBlock Style="{StaticResource Hint}"
                           Margin="28,6,0,0"
                           Text="Off by default. Leaving it off means a game you alt tabbed away from will not black anything out." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <CheckBox Content="Always keep the focused monitor clear"
                          IsChecked="{Binding AlwaysClearFocusedMonitor}" />
                <TextBlock Style="{StaticResource Hint}"
                           Margin="28,6,0,0"
                           Text="A safety net. Whatever you are working in stays visible even if detection gets it wrong." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Always clear" Style="{StaticResource FieldLabel}" />
                <TextBlock Style="{StaticResource Hint}">
                  The monitor the game is on, the monitor with keyboard focus, and any monitor you check on the
                  Monitors page. Everything else goes black while a game is running.
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Blackout -->
        <ScrollViewer x:Name="PageBlackout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="28,26,28,26">
            <TextBlock Text="Blackout" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="What the covered monitors actually show while a game is running." />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <RadioButton Content="Solid black"
                             GroupName="Blackout"
                             Margin="0,0,0,10"
                             IsChecked="{Binding BlackoutIsBlack}" />
                <RadioButton Content="Windows screensaver"
                             GroupName="Blackout"
                             IsChecked="{Binding BlackoutIsScreensaver}" />
                <TextBlock Style="{StaticResource Hint}"
                           Margin="26,8,0,0"
                           Text="The screensaver runs on the covered monitors only. The game monitor and the monitor you are working on are never touched." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" IsEnabled="{Binding BlackoutIsBlack}">
              <StackPanel>
                <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Slider Grid.Column="0"
                          Minimum="20" Maximum="100"
                          TickFrequency="5"
                          IsSnapToTickEnabled="True"
                          AutomationProperties.Name="Overlay opacity"
                          Value="{Binding OverlayOpacity}" />
                  <TextBlock Grid.Column="1"
                             MinWidth="64"
                             Margin="14,0,0,0"
                             TextAlignment="Right"
                             VerticalAlignment="Center"
                             Text="{Binding OverlayOpacityText, Mode=OneWay}" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}"
                           Margin="0,8,0,0"
                           Text="Fully opaque by default. Lower it to see through a covered monitor. This does not apply while a screensaver is running." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" IsEnabled="{Binding BlackoutIsScreensaver}">
              <StackPanel>
                <TextBlock Text="Screensaver" Style="{StaticResource FieldLabel}" />
                <ListBox MaxHeight="190"
                         ItemsSource="{Binding ScreensaverOptions}"
                         SelectedItem="{Binding SelectedScreensaver}"
                         DisplayMemberPath="Name"
                         AutomationProperties.Name="Screensaver" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="Configure..." Click="ConfigureScreensaverClick" />
                  <Button Content="Test" Margin="10,0,0,0" Click="TestScreensaverClick" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Margin="0,12,0,0"
                           Text="Test runs the screensaver for six seconds on every monitor except this one. A screensaver keeps the GPU busy, so a heavy one can cost you frames." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Monitors -->
        <Grid x:Name="PageMonitors" Margin="28,26,28,26" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock Text="Monitors" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Checked monitors never go black. Use this for a chat or dashboard screen you want to keep." />
          </StackPanel>

          <!--
            The arrangement, laid out the way the monitors really sit. The canvas is sized in desktop
            coordinates and the Viewbox scales the whole thing down to fit, so no pixel arithmetic is
            needed here or in the view model. Clicking a monitor is the same as ticking its box.
          -->
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10" Height="128">
            <Viewbox Stretch="Uniform" StretchDirection="Both">
              <ItemsControl ItemsSource="{Binding Monitors}"
                            Width="{Binding MapWidth}"
                            Height="{Binding MapHeight}"
                            AutomationProperties.Name="Monitor arrangement">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding MapLeft}" />
                    <Setter Property="Canvas.Top" Value="{Binding MapTop}" />
                  </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ToggleButton Style="{StaticResource MonitorTile}"
                                  Width="{Binding MapWidth}"
                                  Height="{Binding MapHeight}"
                                  IsChecked="{Binding IsWhitelisted, Mode=TwoWay}"
                                  ToolTip="{Binding Title}"
                                  AutomationProperties.Name="{Binding Title}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Viewbox>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Monitors}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsWhitelisted}"
                              Margin="8"
                              AutomationProperties.Name="{Binding Title}">
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                      </StackPanel>
                    </CheckBox>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Identify monitors" Click="IdentifyMonitorsClick" />
            <TextBlock Style="{StaticResource Hint}"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0"
                       Text="Flashes a number on every screen for two seconds." />
          </StackPanel>
        </Grid>

        <!-- Denylist -->
        <Grid x:Name="PageDenylist" Margin="28,26,28,26" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock Text="Denylist" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="These processes never count as the game. Type a process name to cover every copy of a program, or Browse to pick one exact executable." />
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     x:Name="DenylistEntryBox"
                     Text="{Binding NewDenylistEntry, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Process name to add"
                     KeyDown="DenylistEntryKeyDown"
                     ToolTip="A process name covers every copy of that program. Browse adds one exact executable." />
            <Button Grid.Column="1"
                    Content="Browse..."
                    Margin="10,0,0,0"
                    Click="BrowseDenylistClick" />
            <Button Grid.Column="2"
                    Content="Add"
                    Margin="10,0,0,0"
                    IsEnabled="{Binding CanAddDenylistEntry}"
                    Click="AddDenylistClick" />
          </Grid>

          <ListBox Grid.Row="2"
                   ItemsSource="{Binding Denylist}"
                   SelectedItem="{Binding SelectedDenylistEntry}"
                   AutomationProperties.Name="Denied processes">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" ToolTip="{Binding}">
                  <Image Width="18" Height="18"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         Source="{Binding Converter={StaticResource ProcessIcon}}" />
                  <!-- A path entry shows its file name and the folder it points at. A name entry
                       says "any copy", so the two kinds are never mistaken for each other. The row
                       tooltip carries the whole thing either way. -->
                  <TextBlock Text="{Binding Converter={StaticResource ProcessLabel}}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Converter={StaticResource ProcessDetail}}"
                             Style="{StaticResource Hint}"
                             Margin="10,0,0,0"
                             MaxWidth="380"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap"
                             VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="Remove"
                    IsEnabled="{Binding CanRemoveDenylistEntry}"
                    Click="RemoveDenylistClick" />
            <Button Content="Restore defaults" Margin="10,0,0,0" Click="RestoreDenylistClick" />
          </StackPanel>
        </Grid>

        <!-- On top -->
        <Grid x:Name="PageOnTop" Margin="28,26,28,26" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <TextBlock Text="On top" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="These programs stay visible above a blacked out monitor. Type a process name to cover every copy, or Browse to pick one exact executable." />
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     x:Name="AboveOverlayEntryBox"
                     Text="{Binding NewAboveOverlayEntry, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Program to keep on top"
                     KeyDown="AboveOverlayEntryKeyDown"
                     ToolTip="A process name covers every copy of that program. Browse adds one exact executable." />
            <Button Grid.Column="1"
                    Content="Browse..."
                    Margin="10,0,0,0"
                    Click="BrowseAboveOverlayClick" />
            <Button Grid.Column="2"
                    Content="Add"
                    Margin="10,0,0,0"
                    IsEnabled="{Binding CanAddAboveOverlayEntry}"
                    Click="AddAboveOverlayClick" />
          </Grid>

          <ListBox Grid.Row="2"
                   ItemsSource="{Binding AboveOverlay}"
                   SelectedItem="{Binding SelectedAboveOverlayEntry}"
                   AutomationProperties.Name="Programs kept on top">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" ToolTip="{Binding}">
                  <Image Width="18" Height="18"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         Source="{Binding Converter={StaticResource ProcessIcon}}" />
                  <!-- A path entry shows its file name and the folder it points at. A name entry
                       says "any copy", so the two kinds are never mistaken for each other. The row
                       tooltip carries the whole thing either way. -->
                  <TextBlock Text="{Binding Converter={StaticResource ProcessLabel}}"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Converter={StaticResource ProcessDetail}}"
                             Style="{StaticResource Hint}"
                             Margin="10,0,0,0"
                             MaxWidth="380"
                             TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap"
                             VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
              <Button Content="Remove"
                      IsEnabled="{Binding CanRemoveAboveOverlayEntry}"
                      Click="RemoveAboveOverlayClick" />
              <TextBlock Style="{StaticResource Hint}"
                         VerticalAlignment="Center"
                         Margin="14,0,0,0"
                         Text="Empty by default. A program listed here is put back to normal once blackout ends." />
            </StackPanel>

            <CheckBox Content="Keep the screens black while one of these has focus"
                      Margin="0,14,0,0"
                      IsChecked="{Binding HoldBlackoutForAboveOverlay}" />
            <TextBlock Style="{StaticResource Hint}"
                       Margin="28,6,0,0"
                       Text="Alt tab between the game and these programs without the blackout dropping. The game still has to be running fullscreen, so closing it ends the blackout as usual." />
          </StackPanel>
        </Grid>

        <!-- About -->
        <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="28,26,28,26">
            <TextBlock Text="About" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Blacks out unused monitors while a fullscreen or borderless game is running." />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                <TextBlock x:Name="SignatureText" Style="{StaticResource Hint}" Margin="0,6,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Updates" Style="{StaticResource FieldLabel}" />
                <CheckBox Content="Check for updates automatically" IsChecked="{Binding AutoUpdate}" />
                <TextBlock Style="{StaticResource Hint}"
                           Margin="28,6,0,0"
                           Text="Off by default. When on, BlackScreens asks GitHub once a day whether there is a newer release, downloads it, and installs it when no monitor is blacked out. This is the only time the app uses the network, and nothing about you is sent." />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button x:Name="CheckUpdateButton" Content="Check now" Click="CheckForUpdatesClick" />
                  <Button x:Name="InstallUpdateButton"
                          Content="Restart and install"
                          Margin="10,0,0,0"
                          Visibility="Collapsed"
                          Style="{StaticResource AccentButton}"
                          Click="InstallUpdateClick" />
                </StackPanel>
                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Hint}" Margin="0,10,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Files" Style="{StaticResource FieldLabel}" />
                <TextBlock x:Name="SettingsPathText" Style="{StaticResource Hint}" />
                <TextBlock x:Name="LogPathText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="Open data folder" Click="OpenDataFolderClick" />
                  <Button Content="Open error log" Margin="10,0,0,0" Click="OpenErrorLogClick" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Shortcuts" Style="{StaticResource FieldLabel}" />
                <TextBlock Style="{StaticResource Hint}">
                  Double click the tray icon to open these settings. Right click it for Pause, the monitor
                  whitelist and Quit.
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

      </Grid>
    </Grid>

    <Border Grid.Row="1"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="0,1,0,0"
            Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Style="{StaticResource Hint}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Close" Click="CloseClick" />
          <Button Content="Save"
                  Margin="10,0,0,0"
                  Style="{StaticResource AccentButton}"
                  IsDefault="True"
                  Click="SaveClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
