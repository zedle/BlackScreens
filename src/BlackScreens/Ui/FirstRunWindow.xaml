<Window x:Class="BlackScreens.Ui.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BlackScreens"
        SizeToContent="Height"
        Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource WindowBackgroundBrush}">

  <StackPanel Margin="28,26,28,22">

    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
      <Path Width="26" Height="26"
            Margin="0,1,12,0"
            VerticalAlignment="Top"
            Stretch="None"
            Data="M23,14 A9,9 0 1 1 20.3,7.6 M23,4 V10 H17 M14,10.5 V17 M11,14 L14,17 L17,14"
            Stroke="{DynamicResource AccentBrush}"
            StrokeThickness="1.6"
            StrokeStartLineCap="Round"
            StrokeEndLineCap="Round"
            StrokeLineJoin="Round" />
      <TextBlock Text="Keep BlackScreens up to date?"
                 FontSize="19"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" />
    </StackPanel>

    <TextBlock Style="{StaticResource Hint}" FontSize="13.5" Margin="0,0,0,10">
      BlackScreens can ask GitHub once a day whether there is a newer release, download it, and
      install it at a moment when no monitor is blacked out, so it will never restart on you mid
      game.
    </TextBlock>

    <TextBlock Style="{StaticResource Hint}" FontSize="13.5" Margin="0,0,0,10">
      That check is the only time the app uses the network. Nothing about you is sent, and it stays
      off entirely if you would rather update by hand.
    </TextBlock>

    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,22">
      You can change this at any time on the About page in Settings.
    </TextBlock>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="No thanks" Click="DeclineClick" IsCancel="True" />
      <Button Content="Check automatically"
              Margin="10,0,0,0"
              MinWidth="150"
              Style="{StaticResource AccentButton}"
              IsDefault="True"
              Click="AcceptClick" />
    </StackPanel>

  </StackPanel>
</Window>
