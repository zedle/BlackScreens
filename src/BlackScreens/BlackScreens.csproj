<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>BlackScreens</RootNamespace>
    <AssemblyName>BlackScreens</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Product>BlackScreens</Product>
    <AssemblyTitle>BlackScreens</AssemblyTitle>
    <Authors>Greg Gage</Authors>
    <Company>Greg Gage</Company>
    <Copyright>Copyright (c) 2026 Greg Gage</Copyright>
    <Description>Blacks out unused monitors while a fullscreen or borderless game is running.</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- WFO0003 wants DPI configured through WinForms. This process also hosts WPF, which only reads
         per monitor awareness from the manifest, so the manifest stays the single source of truth. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- WinForms and WPF both ship implicit usings that collide (Application, MessageBox,
       Point, Size, Color, Brush). WinForms wins here; WPF files add explicit usings. -->
  <ItemGroup>
    <Using Remove="System.Windows" />
    <Using Remove="System.Windows.Controls" />
    <Using Remove="System.Windows.Data" />
    <Using Remove="System.Windows.Documents" />
    <Using Remove="System.Windows.Input" />
    <Using Remove="System.Windows.Media" />
    <Using Remove="System.Windows.Media.Imaging" />
    <Using Remove="System.Windows.Navigation" />
    <Using Remove="System.Windows.Shapes" />
    <!-- Enabling WPF drops System.IO from the implicit set. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="BlackScreens.Assets.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlackScreens.Tests" />
  </ItemGroup>
</Project>
