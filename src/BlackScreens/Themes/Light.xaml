<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="WindowBackgroundColor">#FFF4F5F8</Color>
  <Color x:Key="NavBackgroundColor">#FFE9ECF1</Color>
  <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
  <Color x:Key="SurfaceAltColor">#FFF8F9FB</Color>
  <Color x:Key="BorderColor">#FFDDE1E8</Color>
  <Color x:Key="BorderStrongColor">#FFC3C9D4</Color>
  <Color x:Key="TextColor">#FF181B22</Color>
  <Color x:Key="MutedTextColor">#FF5C6473</Color>
  <Color x:Key="AccentColor">#FF2563EB</Color>
  <Color x:Key="AccentTextColor">#FFFFFFFF</Color>
  <Color x:Key="ControlColor">#FFFFFFFF</Color>
  <Color x:Key="ControlHoverColor">#FFEDF0F5</Color>
  <Color x:Key="ControlPressedColor">#FFE0E5EE</Color>
  <Color x:Key="ScrollThumbColor">#FFC3C9D4</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="NavBackgroundBrush" Color="{StaticResource NavBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />

</ResourceDictionary>
