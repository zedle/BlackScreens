<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="WindowBackgroundColor">#FF12141A</Color>
  <Color x:Key="NavBackgroundColor">#FF0D0F14</Color>
  <Color x:Key="SurfaceColor">#FF1A1D25</Color>
  <Color x:Key="SurfaceAltColor">#FF20242E</Color>
  <Color x:Key="BorderColor">#FF2B303B</Color>
  <Color x:Key="BorderStrongColor">#FF3A4150</Color>
  <Color x:Key="TextColor">#FFE7EAF1</Color>
  <Color x:Key="MutedTextColor">#FF98A1B2</Color>
  <Color x:Key="AccentColor">#FF4C8DFF</Color>
  <Color x:Key="AccentTextColor">#FFFFFFFF</Color>
  <Color x:Key="ControlColor">#FF232734</Color>
  <Color x:Key="ControlHoverColor">#FF2D3341</Color>
  <Color x:Key="ControlPressedColor">#FF373E4E</Color>
  <Color x:Key="ScrollThumbColor">#FF3D4453</Color>

  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
  <SolidColorBrush x:Key="NavBackgroundBrush" Color="{StaticResource NavBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}" />
  <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
  <SolidColorBrush x:Key="ControlPressedBrush" Color="{StaticResource ControlPressedColor}" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />

</ResourceDictionary>
